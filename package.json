{
  "name": "myq-garage-worker",
  "version": "1.2.1",
  "description": "Cloudflare Worker that parses myQ garage door notification emails and serves a live status dashboard",
  "author": "Andrew Tryder",
  "license": "MIT",
  "homepage": "https://github.com/andrewtryder/myq-garage-worker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewtryder/myq-garage-worker.git"
  },
  "bugs": {
    "url": "https://github.com/andrewtryder/myq-garage-worker/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "wrangler dev --remote",
    "dev:local": "wrangler dev",
    "frontend:dev": "vite",
    "frontend:build": "vite build",
    "frontend:preview": "vite preview",
    "db:create": "wrangler d1 create myq-garage",
    "db:migrations:local": "wrangler d1 migrations apply GARAGE_DB --local",
    "db:migrations:remote": "wrangler d1 migrations apply GARAGE_DB --remote",
    "deploy": "npm run frontend:build && node scripts/wrangler-deploy.js",
    "types": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit && tsc --noEmit -p frontend/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:email": "node scripts/send-test-email.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.9",
    "wrangler": "^4.127.0"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,jsonc}": [
      "prettier --write"
    ]
  }
}
