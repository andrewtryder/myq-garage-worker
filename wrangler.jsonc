{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myq-garage-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "observability": {
    "enabled": true,
  },
  "vars": {
    "VERSION": "1.0.1", // x-release-please-version
  },
  // Configure how often to check for left-open doors
  "triggers": {
    "crons": ["*/15 * * * *"], // Runs every 15 minutes
  },
  "kv_namespaces": [
    {
      "binding": "GARAGE_STATE",
      "id": "<YOUR_KV_NAMESPACE_ID>", // Run `npm run setup` to create and fill this in
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/devices", "/"],
  },
}
