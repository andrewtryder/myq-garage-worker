{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myq-garage-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "observability": {
    "enabled": true,
  },
  "vars": {
    "VERSION": "1.3.1", // x-release-please-version
    "STALE_AFTER_HOURS": "48",
    "EVENT_TIME_SKEW_HOURS": "6",
  },
  // Configure how often to check for left-open doors
  "triggers": {
    "crons": ["*/15 * * * *"], // Runs every 15 minutes
  },
  "d1_databases": [
    {
      "binding": "GARAGE_DB",
      "database_name": "myq-garage",
      "database_id": "f25d59dc-73a8-4b6b-bcf0-58f052aa4d1e",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/devices", "/health", "/"],
  },
}
